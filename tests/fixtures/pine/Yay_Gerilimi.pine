//@version=5
// ════════════════════════════════════════════════════════════════════════════
//  BTC · YAY GERİLİMİ — Zorunlu Hareket Sinyali   (indicator, strateji DEĞİL)
//
//  Fikir: Fiyat uzun süre sıkıştığında (düşük volatilite + kuruyan hacim) enerji birikir ve sonunda
//  genişleme gelir. Gösterge yalnızca şu koşulların HEPSİ aynı barda oluşunca sinyal verir:
//    1) Yeterince uzun ve derin bir sıkışma yaşandı (BB, Keltner'ın içinde; BB genişliği yılın en dar %20'sinde)
//    2) Sıkışma çözüldü ve fiyat kanalı hacimle kırdı (Donchian kırılımı + hacim onayı)
//    3) Momentum kırılım yönünde ve güçleniyor (TTM tarzı doğrusal regresyon momentumu)
//    4) Haftalık trend aynı yönde (kapanmış haftalık mumdan; yeniden boyama yok)
//    5) Kalabalık pozisyon engeli: perp-spot farkı (funding'in vekili) aşırıysa o yönde sinyal verilmez
//  Sinyal yalnızca mum KAPANINCA oluşur, sonradan silinmez.
//
//  Gösterge kendi sonuçlarını izler: her sinyal için ATR tabanlı hedef/stop belirlenir ve tablo, hedefe
//  ulaşan / stop olan / süre dolan sinyalleri sayar. Başarı oranını böylece kendi grafiğinde görürsünüz.
//  Önerilen: BTCUSDT, 1G (günlük) veya 4S. Geçmiş sonuçlar geleceği garanti etmez, yatırım tavsiyesi değildir.
// ════════════════════════════════════════════════════════════════════════════
indicator("BTC Yay Gerilimi · Zorunlu Hareket", shorttitle="YAY", overlay=true, max_labels_count=200)

// ── Girdiler ──
g1 = "1 · Sıkışma"
bbLen  = input.int(20, "Bollinger / Keltner uzunluğu", minval=5, group=g1)
bbMult = input.float(2.0, "Bollinger çarpanı", minval=0.5, step=0.1, group=g1)
kcMult = input.float(1.5, "Keltner çarpanı", minval=0.5, step=0.1, group=g1)
pctWin = input.int(252, "Yüzdelik penceresi (bar)", minval=50, group=g1)
pctMax = input.float(20.0, "BB genişliği yüzdeliği en çok (%)", minval=1, maxval=50, group=g1)
minSq  = input.int(6, "En az sıkışma süresi (bar)", minval=2, group=g1)
armWin = input.int(5, "Sıkışma bittikten sonra kırılım penceresi (bar)", minval=1, group=g1)

g2 = "2 · Kırılım ve onay"
chLen   = input.int(20, "Kanal (Donchian) uzunluğu", minval=5, group=g2)
volMult = input.float(1.3, "Hacim çarpanı (50 bar ortalamasına göre)", minval=0.5, step=0.1, group=g2)
useWeek = input.bool(true, "Haftalık trend onayı iste", group=g2)

g3 = "3 · Kalabalık pozisyon engeli (ücretsiz veri)"
useBasis = input.bool(true, "Perp-spot farkı engelini kullan", group=g3)
perpSym  = input.symbol("BINANCE:BTCUSDT.P", "Vadeli (perp) sembol", group=g3)
spotSym  = input.symbol("BINANCE:BTCUSDT", "Spot sembol", group=g3)
zMax     = input.float(2.0, "Aşırılık eşiği (σ)", minval=0.5, step=0.1, group=g3)

g4 = "4 · Hedef / stop izleme"
tpMult  = input.float(2.0, "Hedef (ATR çarpanı)", minval=0.5, step=0.25, group=g4)
slMult  = input.float(1.5, "Stop (ATR çarpanı)", minval=0.5, step=0.25, group=g4)
maxBars = input.int(20, "Süre sınırı (bar)", minval=3, group=g4)
cooldown = input.int(15, "İki sinyal arası en az bar", minval=1, group=g4)
showTbl = input.bool(true, "İstatistik tablosunu göster", group=g4)

// ── 1) Sıkışma ──
basis  = ta.sma(close, bbLen)
bbDev  = bbMult * ta.stdev(close, bbLen)
upBB   = basis + bbDev
loBB   = basis - bbDev
kcRng  = ta.sma(ta.tr(true), bbLen)
upKC   = basis + kcMult * kcRng
loKC   = basis - kcMult * kcRng
sqOn   = upBB < upKC and loBB > loKC
bbw    = (upBB - loBB) / basis
bbwRank = ta.percentrank(bbw, pctWin)

var int sqLen = 0
sqLen := sqOn ? sqLen + 1 : 0
released   = not sqOn and sqLen[1] >= minSq
sinceRel   = ta.barssince(released)
deepEnough = ta.lowest(bbwRank, minSq + armWin + 5) <= pctMax
armed      = not na(sinceRel) and sinceRel <= armWin and deepEnough

// ── 2) Kırılım ve onay ──
upBreak = close > ta.highest(high, chLen)[1]
dnBreak = close < ta.lowest(low, chLen)[1]
volOk   = volume > volMult * ta.sma(volume, 50)

// ── 3) Momentum (TTM tarzı) ──
mid = math.avg(math.avg(ta.highest(high, bbLen), ta.lowest(low, bbLen)), ta.sma(close, bbLen))
mom = ta.linreg(close - mid, bbLen, 0)
momUp = mom > 0 and mom > mom[1]
momDn = mom < 0 and mom < mom[1]

// ── 4) Haftalık trend (önceki KAPANMIŞ haftalık mum, yeniden boyama yok) ──
[wEma, wEmaOld] = request.security(syminfo.tickerid, "W", [ta.ema(close, 21)[1], ta.ema(close, 21)[5]], lookahead = barmerge.lookahead_off)
wUp = not useWeek or (close > wEma and wEma > wEmaOld)
wDn = not useWeek or (close < wEma and wEma < wEmaOld)

// ── 5) Kalabalık pozisyon: perp-spot farkı z-skoru ──
perpC = request.security(perpSym, timeframe.period, close, ignore_invalid_symbol = true)
spotC = request.security(spotSym, timeframe.period, close, ignore_invalid_symbol = true)
basisPct = (perpC - spotC) / spotC * 100
bz = (basisPct - ta.sma(basisPct, 100)) / ta.stdev(basisPct, 100)
crowdL = useBasis and not na(bz) and bz > zMax     // uzunlar kalabalık: AL engellenir
crowdS = useBasis and not na(bz) and bz < -zMax    // kısalar kalabalık: SAT engellenir

// ── Sinyal ──
var int lastSig = -100000
coolOk = bar_index - lastSig > cooldown
longSig  = barstate.isconfirmed and armed and upBreak and volOk and momUp and wUp and not crowdL and coolOk
shortSig = barstate.isconfirmed and armed and dnBreak and volOk and momDn and wDn and not crowdS and coolOk

// ── Sonuç izleme (önce eski sinyaller çözülür, sonra yenisi eklenir) ──
var array<int>   sBar   = array.new<int>()
var array<int>   sDir   = array.new<int>()
var array<float> sEntry = array.new<float>()
var array<float> sTp    = array.new<float>()
var array<float> sSl    = array.new<float>()
var int   wins   = 0
var int   losses = 0
var int   timeouts = 0
var float sumR   = 0.0
var int   total  = 0

if barstate.isconfirmed
    int cnt = array.size(sBar)
    if cnt > 0
        for i = cnt - 1 to 0
            int   d  = array.get(sDir, i)
            float e  = array.get(sEntry, i)
            float tp = array.get(sTp, i)
            float sl = array.get(sSl, i)
            int age  = bar_index - array.get(sBar, i)
            bool hitSl = d == 1 ? low <= sl : high >= sl
            bool hitTp = d == 1 ? high >= tp : low <= tp
            bool done = false
            if hitSl                       // aynı barda ikisi de olduysa kötümser: stop sayılır
                losses += 1
                sumR -= 1.0
                done := true
            else if hitTp
                wins += 1
                sumR += math.abs(tp - e) / math.abs(e - sl)
                done := true
            else if age >= maxBars
                timeouts += 1
                sumR += d * (close - e) / math.abs(e - sl)
                done := true
            if done
                array.remove(sBar, i)
                array.remove(sDir, i)
                array.remove(sEntry, i)
                array.remove(sTp, i)
                array.remove(sSl, i)

atrV = ta.atr(14)
if longSig or shortSig
    int dir = longSig ? 1 : -1
    float tpP = close + dir * tpMult * atrV
    float slP = close - dir * slMult * atrV
    array.push(sBar, bar_index)
    array.push(sDir, dir)
    array.push(sEntry, close)
    array.push(sTp, tpP)
    array.push(sSl, slP)
    total += 1
    lastSig := bar_index
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "AL" : "SAT") + "\nHedef " + str.tostring(tpP, format.mintick) + "\nStop " + str.tostring(slP, format.mintick),
         style = dir == 1 ? label.style_label_up : label.style_label_down,
         color = dir == 1 ? color.new(#35d6a0, 10) : color.new(#ff6384, 10), textcolor = color.white, size = size.small)

// ── Görsel ──
bgcolor(sqOn ? color.new(#ffc25c, 88) : na, title = "Sıkışma")
plot(armed ? close : na, "Kırılım penceresi", color = color.new(#ffc25c, 0), style = plot.style_circles, linewidth = 2)
plotshape(longSig,  "AL",  shape.triangleup,   location.belowbar, #35d6a0, size = size.normal)
plotshape(shortSig, "SAT", shape.triangledown, location.abovebar, #ff6384, size = size.normal)

// ── Tablo ──
var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(#0b1220, 15), frame_color = color.new(#7e8ba6, 60), frame_width = 1, border_width = 0)
if showTbl and barstate.islast
    int closed = wins + losses + timeouts
    float wr  = closed > 0 ? 100.0 * wins / closed : na
    float avgR = closed > 0 ? sumR / closed : na
    color wrCol = na(wr) ? color.gray : wr >= 80 ? #35d6a0 : wr >= 50 ? #ffc25c : #ff6384
    table.cell(tb, 0, 0, "YAY · Zorunlu Hareket", text_color = #ffc25c, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, "", text_size = size.small)
    table.cell(tb, 0, 1, "Gerilim (sıkışma)", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, str.tostring(sqLen) + " bar · yüzdelik " + str.tostring(bbwRank, "#"), text_color = sqOn ? #ffc25c : #7e8ba6, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Perp-spot z", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, na(bz) ? "veri yok" : str.tostring(bz, "#.0"), text_color = #7e8ba6, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Toplam sinyal", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, str.tostring(total), text_color = #e9eef8, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, "Hedef / Stop / Süre", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(timeouts), text_color = #e9eef8, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "Hedefe ulaşma oranı", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, na(wr) ? "–" : str.tostring(wr, "#") + "%", text_color = wrCol, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 6, "Ortalama R (beklenti)", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 6, na(avgR) ? "–" : str.tostring(avgR, "#.00"), text_color = na(avgR) ? color.gray : avgR > 0 ? #35d6a0 : #ff6384, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 7, "Açık sinyal", text_color = #e9eef8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 7, str.tostring(array.size(sBar)), text_color = #e9eef8, text_size = size.small, text_halign = text.align_right)

// ── Uyarılar ──
alertcondition(longSig,  "YAY · AL",  "BTC Yay Gerilimi: yukarı yönlü zorunlu hareket sinyali")
alertcondition(shortSig, "YAY · SAT", "BTC Yay Gerilimi: aşağı yönlü zorunlu hareket sinyali")
