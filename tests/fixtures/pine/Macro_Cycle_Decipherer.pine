//@version=5
indicator("XAUUSD Macro Cycle Decipherer", overlay=true, max_labels_count=500)

// ---- GİRDİLER (ALTIN İÇİN OPTİMİZE) ----
fastLen = input.int(50, title="Tetikleyici (50 Günlük EMA)")
slowLen = input.int(200, title="Ana Omurga (200 Günlük SMA)")
topDev  = input.float(1.12, title="Tepe Sınırı (200 SMA'dan %12 Sapma)", step=0.01)

rsiLen  = input.int(14, title="RSI Periyodu")
rsiTop  = input.int(70, title="Haftalık RSI Tepe Sınırı")
rsiDip  = input.int(40, title="Günlük RSI Dip Sınırı")

// ---- HESAPLAMALAR ----
ema50 = ta.ema(close, fastLen)
sma200 = ta.sma(close, slowLen)

// RSI (Haftalık ve Günlük)
weeklyRSI = request.security(syminfo.tickerid, "W", ta.rsi(close, rsiLen))
dailyRSI = ta.rsi(close, rsiLen)

// ---- EVRE VE SİNYAL LOGİKLERİ ----

// 1. DİP (AKÜMÜLASYON) BÖLGESİ
// Altın 200 SMA'ya çok yakınsa (veya altındaysa) ve günlük momentum soğumuşsa
isDipZone = (close <= sma200 * 1.01) and (dailyRSI <= rsiDip)

// 2. BOĞA TEYİDİ (Golden Cross)
// 50 EMA, 200 SMA'yı yukarı keserse
isBullConfirm = ta.crossover(ema50, sma200)

// 3. TEPE (DAĞITIM) BÖLGESİ
// Fiyat 200 SMA'nın %12+ üzerine çıkmışsa VE haftalık RSI 70 üzerine atmışsa
isTopZone = (close >= sma200 * topDev) and (weeklyRSI >= rsiTop)

// 4. AYI / DÜZELTME TEYİDİ (Death Cross)
// 50 EMA, 200 SMA'yı aşağı keserse
isBearConfirm = ta.crossunder(ema50, sma200)

// ---- GÖRSELLEŞTİRME ----
plot(ema50, color=color.blue, linewidth=2, title="50 EMA (Tetikleyici)")
plot(sma200, color=color.orange, linewidth=3, title="200 SMA (Ana Omurga)")

// Tepe Sınırını İnce Kırmızı Çizgiyle Gösterelim
plot(sma200 * topDev, color=color.new(color.red, 50), linewidth=1, title="Makro Tepe Sınırı")

// Arka Plan Trend Renklendirmesi
var int trendState = 0
if (isBullConfirm)
    trendState := 1
if (isBearConfirm)
    trendState := -1

bgcolor(trendState == 1 ? color.new(color.green, 93) : color.new(color.red, 93), title="Makro Trend Arka Planı")

// Sinyal Etiketleri (Labels)
var int lastDipBar = 0
var int lastTopBar = 0

if (isDipZone and ta.change(isDipZone) and bar_index - lastDipBar > 20)
    label.new(bar_index, low, text="🟢 UCUZLUK BÖLGESİ\n(Fırsat)", color=color.green, textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar)
    lastDipBar := bar_index

if (isBullConfirm)
    label.new(bar_index, low, text="🚀 BOĞA TEYİDİ\n(Golden Cross)", color=color.teal, textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar)

if (isTopZone and not isTopZone[1] and bar_index - lastTopBar > 20)
    label.new(bar_index, high, text="🚨 KÖPÜK BÖLGESİ\n(Düzeltme Riski)", color=color.red, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)
    lastTopBar := bar_index

if (isBearConfirm)
    label.new(bar_index, high, text="📉 DÜZELTME TEYİDİ\n(Death Cross)", color=color.maroon, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)