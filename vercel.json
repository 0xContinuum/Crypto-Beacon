{
  "version": 2,
  "builds": [
    {
      "src": "server/app.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "server/app.py" },
    { "source": "/healthz", "destination": "server/app.py" },
    { "source": "/tg/(.*)", "destination": "server/app.py" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ]
}
