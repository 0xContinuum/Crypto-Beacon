{
  "version": 2,
  "builds": [
    {
      "src": "server/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/healthz",
      "dest": "server/app.py"
    },
    {
      "src": "/tg/(.*)",
      "dest": "server/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
